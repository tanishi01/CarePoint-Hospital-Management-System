# Smart Hospital Management System - Environment Variables Template
# Copy this file to .env and adjust values for your local environment

SECRET_KEY=replace_with_a_random_secret_key
APP_ENV=production

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=smart_hospital_db

# Gmail SMTP password reset configuration (use a Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_gmail_address
PUBLIC_BASE_URL=https://your-carepoint-hostname
